{
  "description": "Worked composable exploration scenario over a coaxial glass-slab + thin-lens stack: baseline facts, targeted parameter edit, structural addition of a terminal concave mirror, and bounded slab-index sweep.",
  "baselineFacts": {
    "format": "opticsim-coaxial-paraxial-stack-facts-v1",
    "model": "coaxial-paraxial-optical-stack",
    "signConvention": "x-increasing",
    "lengthUnit": "mm",
    "incidentIndex": 1,
    "object": { "x": -180, "y": 10 },
    "elements": [
      { "id": "S1", "type": "refracting-surface", "x": 0, "signedRadius": "infinity", "downstreamIndex": 1.5 },
      { "id": "S2", "type": "refracting-surface", "x": 30, "signedRadius": "infinity", "downstreamIndex": 1 },
      { "id": "L1", "type": "thin-lens", "x": 90, "focalLength": 100 }
    ]
  },
  "parameterRevisionTemplate": {
    "format": "opticsim-coaxial-stack-revision-v1",
    "intent": "Increase glass-slab refractive index from 1.5 to 1.8 and shift thin lens L1 downstream to x = 110 mm.",
    "changes": [
      { "target": "element", "id": "S1", "field": "downstreamIndex", "value": 1.8 },
      { "target": "element", "id": "L1", "field": "x", "value": 110 }
    ]
  },
  "structureRevisionTemplate": {
    "format": "opticsim-coaxial-stack-structure-v1",
    "intent": "Add a concave terminal mirror M1 behind L1 to inspect symmetric return imaging.",
    "operations": [
      {
        "op": "add-element",
        "position": "end",
        "element": { "id": "M1", "type": "terminal-mirror", "x": 210, "signedRadius": -200 }
      }
    ]
  },
  "sweepTemplate": {
    "format": "opticsim-coaxial-stack-sweep-v1",
    "parameter": { "target": "element", "id": "S1", "field": "downstreamIndex" },
    "values": [1, 1.33, 1.5, 1.8, 2.4],
    "query": { "format": "opticsim-coaxial-paraxial-stack-query-v1", "kind": "coaxial-stack-conjugate" },
    "plot": { "field": "imageX" }
  }
}
